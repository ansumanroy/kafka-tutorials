{
  "namespace": "com.kafkatutorials.serialization.avro",
  "type": "record",
  "name": "UserV1",
  "doc": "User event schema - Version 1",
  "fields": [
    {
      "name": "userId",
      "type": "string",
      "doc": "Unique user identifier"
    },
    {
      "name": "username",
      "type": "string",
      "doc": "User's username"
    },
    {
      "name": "email",
      "type": "string",
      "doc": "User's email address"
    },
    {
      "name": "timestamp",
      "type": "long",
      "doc": "Event timestamp in epoch milliseconds"
    }
  ]
}
